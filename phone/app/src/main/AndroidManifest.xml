<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- SpeechRecognizer 사용 조건. 폰 마이크는 열지 않고 EXTRA_AUDIO_SOURCE 파이프로 차 소리만 넣는다(ADR-0002) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- 화면 회전·다크/라이트 전환·글자 크기·외부 키보드 등으로 세션이 끊기지 않게 Activity를 다시 만들지 않는다 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale|density|locale|layoutDirection|keyboard|navigation|fontWeightAdjustment"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 차 QR 링크. BROWSABLE을 빼서 웹 페이지에서는 열리지 않는다. 열려도 동의 화면을 거친다 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="join"
                    android:scheme="cabincaption" />
            </intent-filter>
        </activity>
    </application>
</manifest>
